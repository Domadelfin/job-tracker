# ---------------------------------------------------------------------------
# RDS PostgreSQL in the private-db subnets (no internet route), reachable only
# from the backend security group. The master password is generated by RDS and
# stored in Secrets Manager: it never appears in code, git, or Terraform state.
# ---------------------------------------------------------------------------

resource "aws_db_subnet_group" "main" {
  name        = "${local.project}-db"
  description = "Private DB subnets (no route to the internet)"
  subnet_ids  = local.f.private_db_subnet_ids
}

resource "aws_db_instance" "main" {
  identifier     = "${local.project}-db"
  engine         = "postgres"
  engine_version = "17"
  instance_class = var.db_instance_class

  db_name  = "jobtracker"
  username = "jobtracker"
  # RDS generates the password and keeps it in Secrets Manager (rotated every 7 days).
  manage_master_user_password = true

  allocated_storage = 20
  storage_type      = "gp3"
  storage_encrypted = true # AWS-managed KMS key, no extra cost

  db_subnet_group_name   = aws_db_subnet_group.main.name
  vpc_security_group_ids = [local.sg.db]
  publicly_accessible    = false
  multi_az               = false # production: true (standby in a second AZ, ~2x cost)

  # Demo settings: fast create/destroy, data is disposable.
  backup_retention_period = 0
  skip_final_snapshot     = true
  deletion_protection     = false
  apply_immediately       = true

  auto_minor_version_upgrade   = true
  performance_insights_enabled = false
  monitoring_interval          = 0
}

# The one extra permission the backend's execution role needs: read THIS secret
# so ECS can inject DB_USER / DB_PASSWORD at container start. Lives and dies with
# this layer. (The secret uses the AWS-managed aws/secretsmanager key, so no
# kms:Decrypt grant is required.)
resource "aws_iam_role_policy" "backend_read_db_secret" {
  name = "read-db-secret"
  role = local.f.execution_role_names["backend"]

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Sid      = "ReadDbSecretOnly"
      Effect   = "Allow"
      Action   = "secretsmanager:GetSecretValue"
      Resource = aws_db_instance.main.master_user_secret[0].secret_arn
    }]
  })
}
